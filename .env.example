# Environment Configuration — LexiDesk Backend
# Copy this file to .env and fill in your values

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/lexidesk

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3001

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ── Seed Admin (SUPER user) ───────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@lexidesk.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Admin
SEED_ADMIN_MOBILE=+919000000000

# ── Storage ───────────────────────────────────────────────────────────────────
# Set to "local" for local dev without AWS
S3_DRIVER=local
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=lexidesk-documents

# ── Magic Links ────────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:3001
MAGIC_LINK_TTL_DAYS=30

# ── AI Verification ────────────────────────────────────────────────────────────
VERIFICATION_PROVIDER=mock
# ANTHROPIC_API_KEY=
