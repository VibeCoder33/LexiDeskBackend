{
    "name": "lexidesk-backend",
    "version": "1.0.0",
    "description": "LexiDesk — Express + TypeScript + Prisma 7 API",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "prisma generate && tsc",
        "start": "node dist/server.js",
        "lint": "eslint src --ext .ts",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write src/**/*.ts",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "db:seed": "ts-node-dev --transpile-only src/seed.ts",
        "db:local": "node scripts/start-local-db.mjs",
        "postinstall": "prisma generate"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1149.0",
        "@aws-sdk/s3-request-presigner": "^3.1149.0",
        "@azure/storage-blob": "^12.34.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.19.2",
        "express-rate-limit": "^8.7.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.20.0",
        "pino": "^9.1.0",
        "pino-pretty": "^11.0.0",
        "zod": "^3.23.4"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/node": "^20.0.0",
        "@types/pg": "^8.11.5",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "embedded-postgres": "^18.4.0-beta.17",
        "eslint": "^8.57.0",
        "prisma": "^7.8.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.4.5"
    },
    "engines": {
        "node": ">=20"
    }
}
